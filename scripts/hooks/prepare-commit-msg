#!/bin/sh
# Strip Cursor attribution from commit messages (IDE/CLI injection).
MSG_FILE="$1"
if [ -f "$MSG_FILE" ]; then
  sed -i '' '/^Co-authored-by: Cursor /d' "$MSG_FILE" 2>/dev/null || \
    sed -i '/^Co-authored-by: Cursor /d' "$MSG_FILE" 2>/dev/null
  sed -i '' '/^Made-with: Cursor/d' "$MSG_FILE" 2>/dev/null || \
    sed -i '/^Made-with: Cursor/d' "$MSG_FILE" 2>/dev/null
  sed -i '' '/cursoragent@cursor\.com/d' "$MSG_FILE" 2>/dev/null || \
    sed -i '/cursoragent@cursor\.com/d' "$MSG_FILE" 2>/dev/null
fi
exit 0
